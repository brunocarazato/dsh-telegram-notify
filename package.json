{
  "name": "dsh-telegram-notify",
  "version": "1.2.0",
  "private": true,
  "description": "Telegram notifications for the DeepSeek Harness: a message when the agent asks a question or finishes its work.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "schema.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "keywords": ["deepseek-harness", "dsh", "telegram", "notifications"],
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
